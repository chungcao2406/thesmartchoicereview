# Copy this file to .env for local development.
# On hosting platforms that don't support custom env vars, the app falls back
# to sensible defaults automatically (see db/database.js) - it will still run.

PORT=3000
NODE_ENV=production

# Site branding
SITE_NAME=TheSmartChoiceReview

# Used only the very first time the app starts (when the users table is empty)
# to create the initial admin account. If not set, defaults to admin / ChangeMe123!
# Change the password immediately from /admin/settings after first login either way.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Optional: override the session signing secret. If not set, a random secret
# is generated once and stored in the database automatically.
# SESSION_SECRET=

# Set to "true" only if the site is served over HTTPS, to mark the session
# cookie as Secure.
FORCE_HTTPS_COOKIE=true
