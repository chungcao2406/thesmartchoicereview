<%- include('partials/header') %>

<section class="hero">
  <div class="container hero-inner">
    <div>
      <span class="hero-eyebrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.5 5.9 20.6l1.3-6.6L2.3 9.4l6.6-.8L12 2z"/></svg>
        Independent &amp; unbiased
      </span>
      <h1>Buy smarter with reviews you can actually trust.</h1>
      <p class="lead">We test, compare and review products across tech, home, fashion and more &mdash; then track down the best verified coupon codes so you never overpay.</p>
      <div class="hero-cta">
        <a href="/reviews" class="btn btn-primary">Browse Reviews</a>
        <a href="/coupons" class="btn btn-outline">See Today's Coupons</a>
      </div>
      <div class="trust-row">
        <span class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
          Hand-tested picks
        </span>
        <span class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/></svg>
          Verified coupon codes
        </span>
        <span class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Updated weekly
        </span>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-card-stack">
        <% if (featuredReviews[0]) { %><%- include('partials/review-card', { review: featuredReviews[0] }) %><% } %>
      </div>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="chip-row" role="navigation" aria-label="Browse by category">
      <% categories.forEach(function(c){ %>
        <a href="/category/<%= c.slug %>" class="chip"><%= c.name %></a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Editor's Picks</h2>
        <p class="section-sub">The products our team stands behind this month.</p>
      </div>
      <a href="/reviews" class="btn btn-outline btn-sm">View all reviews</a>
    </div>
    <div class="grid grid-3">
      <% featuredReviews.forEach(function(review){ %>
        <%- include('partials/review-card', { review: review }) %>
      <% }) %>
    </div>
  </div>
</section>

<% if (featuredCoupons.length) { %>
<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Today's Best Coupons</h2>
        <p class="section-sub">Verified codes, checked regularly.</p>
      </div>
      <a href="/coupons" class="btn btn-outline btn-sm">View all coupons</a>
    </div>
    <div class="grid grid-2">
      <% featuredCoupons.forEach(function(coupon){ %>
        <%- include('partials/coupon-card', { coupon: coupon }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Latest Reviews</h2>
        <p class="section-sub">Fresh off the test bench.</p>
      </div>
    </div>
    <div class="grid grid-4">
      <% latestReviews.forEach(function(review){ %>
        <%- include('partials/review-card', { review: review }) %>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" style="background:var(--color-surface); border-top:1px solid var(--color-border); border-bottom:1px solid var(--color-border);">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Why shoppers trust <%= siteName %></h2>
      </div>
    </div>
    <div class="grid grid-3">
      <div class="card"><div class="card-body">
        <h3>Real, hands-on testing</h3>
        <p class="card-summary">We evaluate products against real-world use cases, not just spec sheets, so our verdicts reflect how they actually perform.</p>
      </div></div>
      <div class="card"><div class="card-body">
        <h3>Transparent about affiliate links</h3>
        <p class="card-summary">Some links earn us a small commission, clearly disclosed on every page. It never influences which products we recommend.</p>
      </div></div>
      <div class="card"><div class="card-body">
        <h3>Coupons we actually check</h3>
        <p class="card-summary">We periodically re-verify coupon codes so you're less likely to land on a dead promo at checkout.</p>
      </div></div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
