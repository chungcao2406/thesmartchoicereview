<%- include('../partials/admin-header') %>

<div class="admin-topbar">
  <h1 style="margin:0;">Messages</h1>
</div>

<div class="admin-card overflow-x">
  <% if (messages.length === 0) { %>
    <p style="color:var(--color-muted-foreground);">No messages yet.</p>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>From</th><th>Subject</th><th>Message</th><th>Received</th><th></th></tr></thead>
      <tbody>
        <% messages.forEach(function(m){ %>
          <tr style="<%= m.is_read ? '' : 'font-weight:700;' %>">
            <td><%= m.name %><br /><span style="font-weight:400; color:var(--color-muted-foreground); font-size:0.82rem;"><%= m.email %></span></td>
            <td><%= m.subject || '—' %></td>
            <td style="max-width:320px;"><%= m.message %></td>
            <td style="font-weight:400; font-size:0.82rem;"><%= m.created_at %></td>
            <td class="table-actions">
              <% if (!m.is_read) { %>
                <form method="POST" action="/admin/messages/<%= m.id %>/read">
                  <button type="submit" class="btn btn-outline btn-sm">Mark Read</button>
                </form>
              <% } %>
              <form method="POST" action="/admin/messages/<%= m.id %>/delete" data-confirm="Delete this message?">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
