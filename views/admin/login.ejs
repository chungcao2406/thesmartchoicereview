<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Login | <%= siteName %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="login-shell">
    <div class="login-box">
      <div class="brand" style="margin-bottom:24px; justify-content:center;">
        <span class="brand-mark">S</span>
        <span>Smart<span class="accent">Choice</span>Review</span>
      </div>
      <h1 style="font-size:1.3rem; text-align:center; margin-bottom:20px;">Admin Login</h1>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/admin/login">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required autofocus />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Log In</button>
      </form>
    </div>
  </div>
</body>
</html>
