<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' && title ? title + ' | ' + siteName : siteName %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Honest, independent product reviews and verified coupons across tech, home, fashion, software and more.' %>" />
  <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : siteName %>" />
  <meta property="og:type" content="website" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%231e3a8a%22/><text x=%2250%22 y=%2266%22 font-size=%2255%22 font-family=%22sans-serif%22 font-weight=%22800%22 fill=%22white%22 text-anchor=%22middle%22>S</text></svg>" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <div class="disclosure-bar">
    We may earn a commission when you buy through links on this site. <a href="/affiliate-disclosure">Learn more</a>.
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="<%= siteName %> home">
        <span class="brand-mark">S</span>
        <span>Smart<span class="accent">Choice</span>Review</span>
      </a>

      <nav class="main-nav" id="main-nav" aria-label="Main navigation">
        <a href="/" aria-current="<%= currentPath === '/' ? 'page' : 'false' %>">Home</a>
        <a href="/reviews" aria-current="<%= currentPath.startsWith('/reviews') ? 'page' : 'false' %>">Reviews</a>
        <a href="/coupons" aria-current="<%= currentPath.startsWith('/coupons') ? 'page' : 'false' %>">Coupons</a>
        <a href="/about" aria-current="<%= currentPath === '/about' ? 'page' : 'false' %>">About</a>
        <a href="/contact" aria-current="<%= currentPath === '/contact' ? 'page' : 'false' %>">Contact</a>
        <form class="search-form" action="/search" method="get" role="search">
          <label for="site-search" class="visually-hidden">Search reviews</label>
          <input id="site-search" type="text" name="q" placeholder="Search reviews..." value="<%= typeof q !== 'undefined' ? q : '' %>" />
          <button type="submit" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
        </form>
      </nav>

      <div class="header-actions">
        <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
